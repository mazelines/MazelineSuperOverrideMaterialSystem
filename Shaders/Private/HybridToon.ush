// Function ID 3: blend continuous lighting with hard Toon bands.
// Change ToonBlend to move between soft stylization (0) and hard bands (1).
void MazelineEvaluateShaderOverride(
    float3 BaseColor, float Metallic, float3 N, float3 V, float3 L,
    inout float3 DiffuseColor, inout float Roughness)
{
    float Facing = dot(normalize(N), normalize(L));
    float SoftLight = lerp(0.35, 1.0, smoothstep(-0.2, 0.8, Facing));
    float Band = Facing > 0.65 ? 1.0 : (Facing > 0.25 ? 0.50 : 0.12);
    float ToonBlend = 0.55;
    DiffuseColor *= lerp(SoftLight, Band, ToonBlend);
    Roughness = saturate(lerp(Roughness, max(Roughness, 0.65), ToonBlend));
}
